# Ajeet's Robots catalog service
# Copy to .env for local development. Do not commit real credentials.

CATALOG_API_BASE_URL=https://catalog-api.internal.example
CATALOG_CACHE_TTL_SECONDS=600
CATALOG_EXPORT_BUCKET=ajeets-robots-catalog-exports
CATALOG_LOG_LEVEL=info
CATALOG_WEBHOOK_SECRET=replace-with-local-secret
CATALOG_LEGACY_FEED_URL=https://legacy-feed.internal.example
